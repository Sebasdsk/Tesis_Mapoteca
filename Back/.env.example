# Copiar a Back/.env SOLO para desarrollo local sin Docker.
# Con docker compose no hace falta: las variables van en docker-compose.yml.
ENVIRONMENT=development
DATABASE_URL=postgresql://mapoteca_user:mapoteca_pass_2024@localhost:5432/mapoteca_db
SECRET_KEY=cambia-esto-por-una-clave-segura-en-produccion
ALLOWED_ORIGINS=http://localhost:4200

# --- Producción (Render) ---
# ENVIRONMENT=production exige:
#   - SECRET_KEY fuerte (>=32 chars), ej: python -c "import secrets; print(secrets.token_hex(32))"
#   - ADMIN_PASSWORD distinta de la default
#   - DEBUG=false
#   - DATABASE_URL de Neon con ?sslmode=require
#   - ALLOWED_ORIGINS con el dominio real del front en Vercel
